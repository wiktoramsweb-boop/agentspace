{
  "name": "agentspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:pola": "node --experimental-strip-types --no-warnings lib/sprawdz-pola.ts",
    "test:warianty": "node lib/sprawdz-warianty.mjs",
    "test:leady": "node --experimental-strip-types --no-warnings lib/sprawdz-leady.ts",
    "test:uprawnienia": "node --experimental-strip-types --no-warnings lib/sprawdz-uprawnienia.ts",
    "test:kredyty": "node --experimental-strip-types --no-warnings lib/sprawdz-kredyty.ts",
    "test:abonament": "node --experimental-strip-types --no-warnings lib/sprawdz-abonament.ts",
    "test:role": "node --experimental-strip-types --no-warnings lib/sprawdz-role.ts",
    "diagnostyka": "node --env-file=.env.local -e \"const t=process.env.DIAG_TOKEN; if(!t){console.error('Brak DIAG_TOKEN w .env.local');process.exit(1)} const url=process.argv[1]||'https://agentspace.pl'; fetch(url+'/api/diagnostyka',{headers:{authorization:'Bearer '+t}}).then(async r=>{if(!r.ok){console.error(r.status, await r.text());process.exit(1)} console.log(JSON.stringify(await r.json(),null,2))})\"",
    "test:faktury": "node --experimental-strip-types lib/sprawdz-faktury.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.23",
    "marked": "^18.0.5",
    "motion": "^12.40.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.14.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
